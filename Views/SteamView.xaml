<UserControl xmlns:controls="clr-namespace:SteamLuaManager.Controls" x:Class="SteamLuaManager.Views.SteamView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:SteamLuaManager.Markup"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <UserControl.Resources>
        <!-- 操作卡片：整块可点，悬停提亮走叠加层，不盖底色 -->
        <Style x:Key="ActionTileStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <Border CornerRadius="8"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Border x:Name="HoverLayer" CornerRadius="8" Opacity="0" IsHitTestVisible="False"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            <ContentPresenter Margin="14,12" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverLayer" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <controls:SmoothScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,24,36,24">

            <TextBlock Text="{l:Loc Steam_Title}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="{l:Loc Steam_Desc}" FontSize="12" Margin="0,0,0,20" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <!-- 启动 / 重启 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="StartButton" Grid.Column="0" Style="{StaticResource ActionTileStyle}"
                        Click="Start_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Margin="0,0,14,0"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <ui:FontIcon Glyph="&#xE768;" FontSize="20"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc Steam_Start}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{l:Loc Steam_StartDesc}" FontSize="12" Margin="0,4,0,0"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ui:FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Margin="8,0,0,0"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Button>

                <Button x:Name="RestartButton" Grid.Column="2" Style="{StaticResource ActionTileStyle}"
                        Click="Restart_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Margin="0,0,14,0"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <ui:FontIcon Glyph="&#xE777;" FontSize="20"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{l:Loc Steam_Restart}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{l:Loc Steam_RestartDesc}" FontSize="12" Margin="0,4,0,0"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <ui:FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="14" Margin="8,0,0,0"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Button>
            </Grid>

            <!-- 账号切换 -->
            <Border CornerRadius="10" BorderThickness="1" Margin="0,14,0,0" Padding="18,16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:FontIcon Grid.Column="0" Glyph="&#xE77B;" FontSize="18" Margin="0,0,10,0"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{l:Loc Steam_AccountTitle}" FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Button Grid.Column="2" Content="{l:Loc Steam_AccountRefresh}" Padding="12,4" FontSize="12"
                                Click="RefreshAccounts_Click">
                            <Button.Background>
                                <SolidColorBrush Color="{DynamicResource ControlFillColorDefault}" Opacity="0.45"/>
                            </Button.Background>
                        </Button>
                    </Grid>
                    <TextBlock Text="{l:Loc Steam_AccountDesc}" FontSize="12.5" Margin="0,6,0,14"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <!-- 空态：读不到 loginusers.vdf 时给一句明确说明，不留白 -->
                    <TextBlock x:Name="AccountEmptyText" Text="{l:Loc Steam_AccountEmpty}" FontSize="13"
                               TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <ItemsControl x:Name="AccountList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="0,0,0,8" CornerRadius="8" Cursor="Hand"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        Tag="{Binding}"
                                        MouseLeftButtonUp="AccountItem_Click"
                                        MouseEnter="AccountItem_MouseEnter"
                                        MouseLeave="AccountItem_MouseLeave">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Margin="0,0,12,0"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                VerticalAlignment="Center">
                                            <Border.Clip>
                                                <RectangleGeometry RadiusX="8" RadiusY="8" Rect="0,0,40,40"/>
                                            </Border.Clip>
                                            <Image Width="40" Height="40" Stretch="UniformToFill" Source="{Binding AvatarPath}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PersonaName}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{Binding AccountName}" FontSize="12" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <!-- 当前登录账号给个标记，避免误切到正在用的那个 -->
                                        <Border Grid.Column="2" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}"
                                                Margin="10,0,0,0" Padding="8,2" CornerRadius="9" VerticalAlignment="Center"
                                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                                            <TextBlock Text="{l:Loc Steam_AccountCurrent}" FontSize="11" Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </controls:SmoothScrollViewer>
</UserControl>
